# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/

# Heavy run corpora + model artifacts (regenerated on the cluster; see docs/DATA.md)
reports/
*.npz

# Figure build outputs (regenerated by `make figures`).
# The two oracle/cluster-gated figures (fig08, fig09) are force-added as a
# documented fallback so `pdflatex` always works — see docs/DATA.md.
paper/figures/figdata/*.json

# Table build outputs (recomputed by `make tabdata`). The rendered tab??_*.tex ARE
# committed, so `pdflatex` always works — as the figure PDFs are.
paper/tables/tabdata/*.json

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.out
paper/*.blg

# OS / editor
.DS_Store

# Cloud-sync conflicted-copy artifacts (never commit these)
* [0-9].*

# SLURM job logs (created at submit time)
logs/
